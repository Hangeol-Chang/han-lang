{
  "name": "han-lang",
  "homepage": "https://hangeol-chang.github.io/han-lang",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "bin": {
    "hanlang": "dist/cli/hanlang.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "build:cli": "tsc -p tsconfig.cli.json",
    "package:cli": "npm run build:cli && pkg dist/cli/hanlang.js --targets node22-win-x64,node22-linux-x64,node22-macos-x64 --output dist/bin/hanlang",
    "deploy": "rm -rf node_modules/.cache && next build && next export && touch out/.nojekyll && git add out/ -f && git commit -m \"Deploy Next.js to gh-pages\" && git subtree push --prefix out origin gh-pages"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "14.0.3",
    "react": "^18",
    "react-dom": "^18",
    "recoil": "^0.7.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@yao-pkg/pkg": "^6.21.0",
    "eslint": "^8",
    "eslint-config-next": "14.0.3",
    "typescript": "^5"
  }
}
